<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SudokuProj.SudokuPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a hovercraft number nine" />
            <ListView ItemsSource="{Binding Suduko.PuzzleImages}" ItemSelected="OnListViewitemSelected">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid RowDefinitions="200,200,200" ColumnDefinitions="200,200,200" FlexLayout.AlignSelf="Auto">
                                <Image
                                    Source="{Binding .}"
                                    Aspect="AspectFill"
                                    HeightRequest="200"
                                    />
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Label
                x:Name="TXT">
            </Label>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>